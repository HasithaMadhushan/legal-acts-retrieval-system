# Production environment example only.
# Do not commit real secrets, passwords, private database URLs, or AWS credentials.

# Backend
APP_NAME=Automated Legal Acts Retrieval System
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://APP_USER:APP_PASSWORD@RDS_HOST:RDS_PORT/legal_acts
SECRET_KEY=replace-with-strong-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
DOCLING_ENABLED=true
DOCLING_TIMEOUT_SECONDS=60
OCR_ENABLED=false
ENABLE_PGVECTOR=false
DOC_PARSER_PRIMARY=docling

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1

# Future AWS storage placeholders, not wired to application code yet
AWS_REGION=ap-south-1
S3_UPLOAD_BUCKET=legal-acts-uploads
S3_UPLOAD_PREFIX=uploads/
