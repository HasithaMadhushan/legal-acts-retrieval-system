APP_NAME=Automated Legal Acts Retrieval System
ENVIRONMENT=development
SECRET_KEY=change-this-development-secret
DATABASE_URL=sqlite:///./legal_acts.db
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=480
PDF_INSPECTOR_ENABLED=true
PDF_INSPECTOR_OCR_MODEL_DIRECTORY=/opt/pdf-inspector/models
DOCLING_ENABLED=false
DOCLING_TIMEOUT_SECONDS=60
OCR_ENABLED=true
DOC_PARSER_PRIMARY=pymupdf

# "console" is human-friendly for local dev; use "json" in real deployments so
# log aggregators (CloudWatch, Loki, etc.) can parse each line.
LOG_LEVEL=INFO
LOG_FORMAT=console
# Optional: set to enable Sentry error tracking. Left unset by default.
SENTRY_DSN=

# Per-client-IP throttle on /auth/register and /auth/login.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=20/minute
SEARCH_RATE_LIMIT=60/minute

# Only used by docker-compose (see backend/Dockerfile); gunicorn worker count.
WEB_CONCURRENCY=2

# Uploaded PDFs are stored on local disk by default. Set S3_BUCKET to instead
# store them in S3 or an S3-compatible service (Cloudflare R2, MinIO, ...);
# credentials come from the standard AWS_* environment variables, not from here.
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=

# LLM hybrid extraction (off until gold-set eval says it beats regex-only)
LLM_EXTRACTION_ENABLED=false
# gemini | openai | anthropic | mistral | openai-compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
# Required only for LLM_PROVIDER=openai-compatible. Include the provider's /v1 path.
LLM_BASE_URL=
LLM_MAX_SECTIONS_PER_ACT=40

# Semantic search (off until retrieval eval says it beats keyword search)
SEMANTIC_SEARCH_ENABLED=false
ENABLE_PGVECTOR=true
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_MODEL_TIMEOUT_SECONDS=120
SEMANTIC_CANDIDATE_LIMIT=100
HYBRID_RRF_K=60
HYBRID_KEYWORD_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=1.0

# SonarQube Cloud user token for Cursor MCP (never commit the real value).
# Create at https://sonarcloud.io/account/security
# SONARQUBE_TOKEN=

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Production-only (docker-compose.prod.yml); see that file's header comment ---
# POSTGRES_PASSWORD=
# CORS_ORIGINS=https://your-domain.example.com
# NEXT_PUBLIC_API_BASE_URL=https://your-domain.example.com/api/v1
# PUBLIC_DOMAIN=your-domain.example.com
